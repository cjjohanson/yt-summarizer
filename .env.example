# Required for default configuration:
# Groq key is needed for Whisper transcription (default transcriber)
GROQ_API_KEY=your-groq-key-here
# Anthropic key is needed for Claude summarization (default LLM)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: only needed if using OpenAI as transcriber or LLM provider
# OPENAI_API_KEY=your-openai-key-here

# Optional: defaults shown
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# TRANSCRIBER=groq
# WHISPER_SERVER_URL=http://host.docker.internal:8080  # only for --transcriber local
# WHISPER_TIMEOUT=600                                   # only for --transcriber local
